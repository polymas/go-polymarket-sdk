# go-polymarket-sdk 本地配置模板
#
# SDK 不会自动加载该文件。复制后执行 `source .env`，或由进程管理器注入。
# 只填写当前示例/测试实际需要的变量，不要提交 .env。

# 钱包与网络 ---------------------------------------------------------------

# 认证、签名或链上操作需要；0x 前缀可选。
export POLY_PRIVATE_KEY="0x..."

# 必须与 Polymarket 账户的钱包结构一致：
# 0=EOA, 1=Proxy, 2=Safe, 3=POLY_1271/Deposit Wallet
export POLY_SIGNATURE_TYPE=2

# 部分示例支持自定义 Polygon RPC；留空时不要把空值传给 web3.NewClient。
# export POLY_RPC_URL="https://polygon-rpc.example.com"

# API / builder 凭证 -------------------------------------------------------

# 部分 relayer、提现或诊断示例使用。
export POLY_API_KEY=""
export POLY_API_SECRET=""
export POLY_API_PASSPHRASE=""

# 部分 builder/gasless 集成测试使用。
export POLY_BUILDER_API_KEY=""
export POLY_BUILDER_SECRET=""
export POLY_BUILDER_PASSPHRASE=""

# 只读测试数据 -------------------------------------------------------------

# outcome token ID：uint256 十进制字符串。
export POLY_TEST_TOKEN_ID=""
export POLY_TEST_CONDITION_ID="0x..."
export POLY_TEST_MARKET_ID=""
export POLY_TEST_MARKET_SLUG=""
export POLY_TEST_EVENT_ID=""

# 真实写入测试 -------------------------------------------------------------

# 不在模板中默认开启任何 POLY_RUN_* 开关。真实下单、撤单、授权和链上交易
# 必须按 docs/testing.md 与对应测试源码逐项显式启用。
